{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Scan": {
      "title": "Scan",
      "description": "Vulnerability scan results",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "url": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "riskScore": { "type": "integer" },
        "vulnerabilityCount": { "type": "integer" },
        "status": { "enum": ["pending", "completed", "failed"] },
        "results": { "type": "object" },
        "aiSummary": { "type": "string" }
      },
      "required": ["userId", "url", "timestamp"]
    },
    "Alert": {
      "title": "Alert",
      "description": "Security alerts and notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "isRead": { "type": "boolean" }
      },
      "required": ["userId", "message", "severity"]
    },
    "Report": {
      "title": "Report",
      "description": "Downloadable security reports",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "scanId": { "type": "string" },
        "format": { "enum": ["pdf", "json"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "reportData": { "type": "string" }
      },
      "required": ["userId", "scanId", "format"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Primary user documents"
    },
    "/scans/{scanId}": {
      "schema": "Scan",
      "description": "Collection of all vulnerability scans"
    },
    "/alerts/{alertId}": {
      "schema": "Alert",
      "description": "Security notifications for users"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Stored security reports"
    }
  }
}
